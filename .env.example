# Optional keys. Copy to .env and uncomment what you need.
# Production (docker-compose.host.yml) does not need ROON_CORE_HOST.

# Optional operator fallback only. Prefer pasting a key in Settings.
# OPENAI_API_KEY=
# CERT_HOSTS=192.168.0.13
# SSL_CERT=
# SSL_KEY=
# ROON_CORE_HOST=
# ROON_CORE_PORT=9330
# HTTP_PORT=3000
# HTTPS_PORT=3443
