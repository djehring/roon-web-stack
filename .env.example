# Optional keys. Copy to .env and uncomment what you need.
# Production (docker-compose.host.yml) does not need ROON_CORE_HOST.

# Optional operator fallback only. Prefer pasting the key once in web Settings.
# OPENAI_API_KEY=
# AI Search interpretation model and reasoning effort. Defaults: gpt-5-mini at low (about 4s).
# Compare candidates on the golden queries before changing (see discovery-routing.live.test.ts).
# DISCOVERY_MODEL=gpt-5.4-mini
# DISCOVERY_EFFORT=none
# CERT_HOSTS=192.168.0.13
# SSL_CERT=
# SSL_KEY=
# ROON_CORE_HOST=
# ROON_CORE_PORT=9330
# HTTP_PORT=3000
# HTTPS_PORT=3443
